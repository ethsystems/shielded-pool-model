-- UNFOLD: round-cut lemmas (no numerals)
theorem noirRound_first {j : ℕ} (h : j < 3) (s : St) :
    noirRound j s = applyMatrix noirM (addC (sigma s) (rc3 (3 * (j + 1)))) := by
  unfold noirRound; split_ifs <;> first | omega | rfl

theorem noirRound_three (s : St) : noirRound 3 s = applyMatrix noirP (addC (sigma s) (rc3 12)) := by
  unfold noirRound; split_ifs <;> first | omega | rfl

theorem noirRound_partial {j : ℕ} (h1 : 4 ≤ j) (h2 : j < 61) (s : St) :
    noirRound j s = partialStep s (j - 4) := by
  unfold noirRound; split_ifs <;> first | omega | rfl

theorem noirRound_second {j : ℕ} (h1 : 61 ≤ j) (h2 : j < 64) (s : St) :
    noirRound j s = applyMatrix noirM (addC (sigma s) (rc3 (72 + 3 * (j - 61)))) := by
  unfold noirRound; split_ifs <;> first | omega | rfl

theorem noirRound_last (s : St) : noirRound 64 s = applyMatrix noirM (sigma s) := by
  unfold noirRound; split_ifs <;> first | omega | rfl

theorem plainRound_full {j : ℕ} (h : j < 4 ∨ 61 ≤ j) (x : St) :
    plainRound j x = pmix plainM (sboxAll (x + plainC j)) := by
  unfold plainRound; split_ifs <;> first | omega | rfl

theorem plainRound_partial {j : ℕ} (h1 : 4 ≤ j) (h2 : j < 61) (x : St) :
    plainRound j x = pmix plainM (sbox0 (x + plainC j)) := by
  unfold plainRound; split_ifs <;> first | omega | rfl

theorem L_aff {j : ℕ} (h1 : 4 ≤ j) (h2 : j ≤ 60) (x : St) : L j x = aff (Tw j) (vw j) x := by
  unfold L; split_ifs <;> first | omega | rfl

theorem L_full {j : ℕ} (h : j ≤ 3 ∨ (61 ≤ j ∧ j ≤ 64)) (x : St) : L j x = x + plainC j := by
  unfold L; split_ifs <;> first | omega | rfl

theorem L_65 (x : St) : L 65 x = x := by
  unfold L; split_ifs <;> first | omega | rfl

theorem aff_I3 (c y : St) : aff I3 c y = y + c := by
