    (hT : T.a00 = 1 ∧ T.a01 = 0 ∧ T.a02 = 0 ∧ T.a10 = 0 ∧ T.a20 = 0)
    (hv0 : v.1 = c.1)
    (hTS : mm T ⟨s0, s3, s4, s1, 1, 0, s2, 0, 1⟩ = mm M T')
    (hv' : v' = vm (k, v.2.1 - (vm c T).2.1, v.2.2 - (vm c T).2.2) ⟨s0, s3, s4, s1, 1, 0, s2, 0, 1⟩) :
    partialBody k s0 s1 s2 s3 s4 (aff T v x) = aff T' v' (pmix M (sbox0 (x + c))) := by
  obtain ⟨x0, x1, x2⟩ := x
  obtain ⟨c0, c1, c2⟩ := c
  obtain ⟨v0, v1, v2⟩ := v
  obtain ⟨t00, t01, t02, t10, t11, t12, t20, t21, t22⟩ := T
  obtain ⟨u00, u01, u02, u10, u11, u12, u20, u21, u22⟩ := T'
  obtain ⟨m00, m01, m02, m10, m11, m12, m20, m21, m22⟩ := M
  obtain ⟨h00, h01, h02, h10, h20⟩ := hT
  change t00 = 1 at h00
  change t01 = 0 at h01
  change t02 = 0 at h02
  change t10 = 0 at h10
  change t20 = 0 at h20
  change v0 = c0 at hv0
  subst t00 t01 t02 t10 t20 c0 v'
  simp only [mm, M3.mk.injEq] at hTS
  obtain ⟨e00, e01, e02, e10, e11, e12, e20, e21, e22⟩ := hTS
  simp only [partialBody, aff, vm, pmix, sbox0, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (x0 + v0) ^ 5 * e00 + (x1 + c1) * e10 + (x2 + c2) * e20
  · linear_combination (x0 + v0) ^ 5 * e01 + (x1 + c1) * e11 + (x2 + c2) * e21
  · linear_combination (x0 + v0) ^ 5 * e02 + (x1 + c1) * e12 + (x2 + c2) * e22

theorem full_step (x c c' C : St) (Mn M : M3) (hM : Mn = M) (hC : vm C M = c') :
    applyMatrix Mn (addC (sigma (x + c)) C) = pmix M (sboxAll (x + c)) + c' := by
  subst Mn c'
  obtain ⟨x0, x1, x2⟩ := x
  obtain ⟨c0, c1, c2⟩ := c
  obtain ⟨C0, C1, C2⟩ := C
  simp only [applyMatrix, addC, sigma, pmix, sboxAll, vm, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> ring

theorem pre_step (x c C v' : St) (P M T' : M3) (hP : P = mm M T') (hv' : v' = vm C P) :
    applyMatrix P (addC (sigma (x + c)) C) = aff T' v' (pmix M (sboxAll (x + c))) := by
  subst v' P
  obtain ⟨x0, x1, x2⟩ := x
  obtain ⟨c0, c1, c2⟩ := c
  obtain ⟨C0, C1, C2⟩ := C
  simp only [applyMatrix, addC, sigma, pmix, sboxAll, vm, aff, mm, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> ring

theorem last_step (x c : St) (Mn M : M3) (hM : Mn = M) :
    applyMatrix Mn (sigma (x + c)) = pmix M (sboxAll (x + c)) := by
  subst Mn
  obtain ⟨x0, x1, x2⟩ := x
  obtain ⟨c0, c1, c2⟩ := c
  simp only [applyMatrix, sigma, pmix, sboxAll, Prod.mk_add_mk, Prod.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> ring

-- COMPOSE
/-- The loop-shaped transcription equals the 65-round cut. After the prologue check, both sides
unfold to the same round sequence (definitional, checked by `rfl`). -/
theorem noirPermute_eq_fold (s : St) :
    noirPermute s = (List.range 65).foldl (fun s j => noirRound j s) (L 0 s) := by
  have h0 : L 0 s = addC s (rc3 0) := by
    rw [L_full (j := 0) (by omega), show plainC 0 = rc3 0 by decide +kernel]
    rfl
  have e1 : ∀ s : St, (List.range (8 / 2 - 1)).foldl
      (fun s r => applyMatrix noirM (addC (sigma s) (rc3 (3 * (r + 1))))) s =
      (List.range 3).foldl (fun s j => noirRound j s) s := fun s =>
    List.foldl_ext _ _ _ (fun s r hr => (noirRound_first (List.mem_range.1 hr) s).symm)
  have e2 : ∀ s : St, (List.range 57).foldl partialStep s =
      (List.range 57).foldl (fun s i => noirRound (4 + i) s) s := by
    intro s
    refine List.foldl_ext _ _ _ (fun s i hi => ?_)
    have hi' := List.mem_range.1 hi
    rw [noirRound_partial (j := 4 + i) (by omega) (by omega), show 4 + i - 4 = i by omega]
  have e3 : ∀ s : St, (List.range (8 / 2 - 1)).foldl
      (fun s r => applyMatrix noirM (addC (sigma s) (rc3 ((8 / 2 + 1) * 3 + 57 + r * 3)))) s =
      (List.range 3).foldl (fun s i => noirRound (61 + i) s) s := by
    intro s
    refine List.foldl_ext _ _ _ (fun s i hi => ?_)
    have hi' := List.mem_range.1 hi
    rw [noirRound_second (j := 61 + i) (by omega) (by omega),
      show (8 / 2 + 1) * 3 + 57 + i * 3 = 72 + 3 * (61 + i - 61) by omega]
  have split : List.range 65 = List.range 3 ++ [3] ++ (List.range 57).map (fun i => 4 + i) ++
      (List.range 3).map (fun i => 61 + i) ++ [64] := by decide
  rw [h0, split, List.foldl_append, List.foldl_append, List.foldl_append, List.foldl_append,
    List.foldl_map, List.foldl_map, List.foldl_cons, List.foldl_nil, List.foldl_cons, List.foldl_nil]
  try beta_reduce
  rw [← e1, ← e2, ← e3, noirRound_three, noirRound_last]
  unfold noirPermute
  rfl

theorem perm_eq_of_rounds
    (h : ∀ j < 65, ∀ x, noirRound j (L j x) = L (j + 1) (plainRound j x)) :
    ∀ s, noirPermute s = plainPerm s := by
  intro s
  have key : ∀ n, n ≤ 65 → (List.range n).foldl (fun s j => noirRound j s) (L 0 s) =
      L n ((List.range n).foldl (fun s j => plainRound j s) s) := by
    intro n hn
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [List.range_succ, List.foldl_append, List.foldl_append, List.foldl_cons, List.foldl_nil,
        List.foldl_cons, List.foldl_nil]
      try beta_reduce
      rw [ih (by omega), h n (by omega)]
  rw [noirPermute_eq_fold, plainPerm, key 65 le_rfl, L_65]


end HashAgreement
