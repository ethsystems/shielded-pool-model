-- Control sender_rom_salt_term_minus_one (generated by scripts/gen-controls.py): SenderGame.ROMCommit.Security cut after `advantage_le_queryBound`,
-- with one change to its statement. It must fail.
import SenderGame.ROMCommit.Hiding

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option linter.unusedSectionVars false
open OracleComp OracleSpec ENNReal OracleComp.DeferredSampling

namespace LeanShieldedPool.SenderGame.ROMCommit
open GameCorrespondence WithdrawGame CommitROM CommitROM.Model
variable {P : PrimSpec} {ι : Type} {cap : Nat}
variable [Fintype ι] [Fintype P.SpendKey] [Finite P.Token] [Finite P.PubKey]
  [Finite P.Commitment] [Finite P.Nullifier] [Fintype P.Salt]
  [Nonempty P.SpendKey] [Nonempty P.PubKey] [Nonempty P.Nullifier] [Nonempty P.Commitment]
  [SampleableType P.SpendKey] [SampleableType P.Nullifier] [SampleableType P.Salt]
  [SampleableType P.Commitment]
  [SampleableType (ι → P.SpendKey)] [SampleableType (ι → P.PubKey)]
  [SampleableType (WithdrawGame.Transport.Table P ι)] [SampleableType (P.SpendKey → P.PubKey)]
  [SampleableType (P.SpendKey × P.Commitment → P.Nullifier)]
  [SampleableType (Model.Table P cap)] [SampleableType (Message P cap → P.Commitment)]

noncomputable def ideal (adv : Adversary P ι cap) : ProbComp Bool := do
  let hc ← $ᵗ (Model.Table P cap)
  let hp ← $ᵗ (P.SpendKey → P.PubKey)
  let hn ← $ᵗ (P.SpendKey × P.Commitment → P.Nullifier)
  let pk ← $ᵗ (ι → P.PubKey)
  let f ← $ᵗ (WithdrawGame.Transport.Table P ι)
  SenderGame.test (baseAdversary adv hp hn hc) pk f

theorem idealAt_eq_kernel (adv : Adversary P ι cap) (hc : Model.Table P cap) :
    WithdrawGame.ROM.Kernel.ideal (SenderGame.ROM.test (lowerAdversary adv hc)) = (do
      let hp ← $ᵗ (P.SpendKey → P.PubKey)
      let hn ← $ᵗ (P.SpendKey × P.Commitment → P.Nullifier)
      let pk ← $ᵗ (ι → P.PubKey)
      let f ← $ᵗ (WithdrawGame.Transport.Table P ι)
      SenderGame.test (baseAdversary adv hp hn hc) pk f) := by
  simp only [WithdrawGame.ROM.Kernel.ideal, WithdrawGame.ROM.sampleTables, bind_assoc, pure_bind,
    SenderGame.ROM.run_test, baseAdversary_eq]

theorem guarded_distance (sup : P.Token → Prop) (adv : Adversary P ι cap) :
    (experiment sup adv).boolDistAdvantage (unguarded adv) ≤ rejectionProbability sup adv / 2 := by
  classical
  let := Fintype.ofFinite (Model.Table P cap)
  have h := SenderGame.ROM.average_distance_le ($ᵗ (Model.Table P cap))
    (fun hc => SenderGame.ROM.experiment (P := commitPrim P cap hc) sup (lowerAdversary adv hc))
    (fun hc => SenderGame.ROM.realUnguarded (lowerAdversary adv hc))
    (fun hc => SenderGame.ROM.sampleOracles (P := commitPrim P cap hc) >>=
      SenderGame.ROM.rejectionBit sup (lowerAdversary adv hc)) (1/2) (fun hc => by
        have hr := SenderGame.ROM.guarded_distance (P := commitPrim P cap hc) sup (lowerAdversary adv hc)
        simpa only [SenderGame.ROM.rejectionProbability, div_eq_mul_inv, mul_comm, one_mul] using hr)
  simpa only [experiment, unguarded, rejectionProbability, div_eq_mul_inv, mul_comm, one_mul] using h

theorem key_switch_bound (adv : Adversary P ι cap) (qc qg : Nat) (hq : QueryBound adv qc qg) :
    (unguarded adv).boolDistAdvantage (ideal adv) ≤
      (Fintype.card ι : ℝ) * (qc+qg) / Fintype.card P.SpendKey +
      (Fintype.card ι : ℝ) * (Fintype.card ι-1) / Fintype.card P.SpendKey := by
  unfold unguarded ideal
  apply PoolGame.Averaging.boolDistAdvantage_bind_le_const
  intro hc _
  have h := WithdrawGame.ROM.Kernel.switch_bound (SenderGame.ROM.test (lowerAdversary adv hc)) (qc+qg)
    (SenderGame.ROM.test_bound (lowerAdversary adv hc) qc qg (lowerAdversary_bound adv hc qc qg hq))
  unfold ProbComp.boolDistAdvantage at h ⊢
  rw [← probOutput_congr (x := true) rfl (SenderGame.ROM.real_eq_kernel (lowerAdversary adv hc)),
    idealAt_eq_kernel] at h
  simpa only [Nat.cast_add] using h

theorem ideal_bias_le (adv : Adversary P ι cap) (qc qg L : Nat)
    (hq : QueryBound adv qc qg) (hL : HistoryBound adv L) :
    |(Pr[= true | ideal adv]).toReal - 1/2| ≤
      (2*(qc+6*L+4+qg)+1 : ℝ) / Fintype.card P.Salt := by
  let side : ProbComp ((P.SpendKey → P.PubKey) × (P.SpendKey × P.Commitment → P.Nullifier) × (ι → P.PubKey)) := do
    let hp ← $ᵗ (P.SpendKey → P.PubKey)
    let hn ← $ᵗ (P.SpendKey × P.Commitment → P.Nullifier)
    let pk ← $ᵗ (ι → P.PubKey)
    pure (hp,hn,pk)
  let atSide := fun t : (P.SpendKey → P.PubKey) × (P.SpendKey × P.Commitment → P.Nullifier) × (ι → P.PubKey) => do
    let hc ← $ᵗ (Model.Table P cap)
    let f ← $ᵗ (WithdrawGame.Transport.Table P ι)
    SenderGame.test (baseAdversary adv t.1 t.2.1 hc) t.2.2 f
  have he : 𝒮[ideal adv] = 𝒮[side >>= atSide] := by
    have hh := evalSPMF_bind_comm ($ᵗ (Model.Table P cap)) side
      (fun hc t => do
        let f ← $ᵗ (WithdrawGame.Transport.Table P ι)
        SenderGame.test (baseAdversary adv t.1 t.2.1 hc) t.2.2 f)
    simpa only [ideal, side, atSide, bind_assoc, pure_bind] using hh
  have h := PoolGame.Averaging.boolDistAdvantage_bind_le_const side atSide (fun _ => $ᵗ Bool)
    ((2*(qc+6*L+4+qg)+1 : ℝ) / Fintype.card P.Salt) (by
      intro t _
      rw [PrivacyTools.distance_fair]
      exact idealAt_bias_le adv qc qg L hq hL t.1 t.2.1 t.2.2)
  rw [probOutput_congr (x := true) rfl he]
  simpa [ProbComp.boolDistAdvantage] using h

/-- Sender privacy in the three-oracle model, without statistical commitment hiding. -/
theorem advantage_le_queryBound (sup : P.Token → Prop) (adv : Adversary P ι cap)
    (qc qg L : Nat) (hq : QueryBound adv qc qg) (hL : HistoryBound adv L) :
    advantage sup adv ≤
      (Fintype.card ι : ℝ) * (qc+qg) / Fintype.card P.SpendKey +
      (Fintype.card ι : ℝ) * (Fintype.card ι-1) / Fintype.card P.SpendKey +
      (2*(qc+6*L+4+qg) : ℝ) / Fintype.card P.Salt +
      rejectionProbability sup adv / 2 := by
  have hr := guarded_distance sup adv
  have hs := key_switch_bound adv qc qg hq
  have hi := ideal_bias_le adv qc qg L hq hL
  have ht := abs_sub_le (Pr[= true | experiment sup adv]).toReal
    (Pr[= true | unguarded adv]).toReal (1/2)
  have ht' := abs_sub_le (Pr[= true | unguarded adv]).toReal
    (Pr[= true | ideal adv]).toReal (1/2)
  unfold advantage ProbComp.boolDistAdvantage at *
  linarith
