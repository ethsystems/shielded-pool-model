-- Control sender_hiding_dropped (generated by scripts/gen-controls.py): SenderGame.Transport cut after `advantage_le`,
-- with one change to its statement. It must fail.
import SenderGame.Basic
import PrivacyTools.Basic

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 400000

open OracleComp OracleSpec ENNReal OracleComp.DeferredSampling

namespace LeanShieldedPool.SenderGame
open GameCorrespondence WithdrawGame.Transport PrivacyTools
variable {P : PrimSpec} {ι : Type}

theorem prior_update [DecidableEq (ι × P.Commitment)] (pk : ι → P.PubKey)
    (f : Table P ι) (x : ι × P.Commitment) (u : P.Nullifier) (c : Challenge P ι)
    (hx : x ∉ c.prior.flatMap (queries pk)) :
    c.prior.map (event pk (Function.update f x u)) = c.prior.map (event pk f) := by
  apply List.map_congr_left
  intro i hi
  apply event_update
  intro h
  exact hx (List.mem_flatMap.mpr ⟨i, hi, h⟩)

/-- Both input coordinates are resampled while preserving the entire mixed-prefix view. -/
theorem fresh_guess_uniform [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType (Table P ι)] (adv : Adversary P ι) (pk : ι → P.PubKey)
    (c : Challenge P ι) (state : adv.State) (s₁ s₂ : P.Salt) (b : Bool) (h : Fresh pk c) :
    𝒮[do let f ← $ᵗ (Table P ι); adv.guess state pk (view pk f c s₁ s₂ b)] =
    𝒮[do
      let u ← $ᵗ P.Nullifier
      let v ← $ᵗ P.Nullifier
      let f ← $ᵗ (Table P ι)
      let w := c.world b
      adv.guess state pk (c.prior.map (event pk f) ++
        [PoolGame.Event.transfer u v (cm pk (w.out1.note s₁)) (cm pk (w.out2.note s₂))])] := by
  classical
  obtain ⟨hx, hy, hxy⟩ := h b
  rw [uniform_update_cont (first pk (c.world b))]
  apply evalSPMF_bind_congr_left
  intro u
  rw [uniform_update_cont (second pk (c.world b))]
  apply evalSPMF_bind_congr_left
  intro v
  apply evalSPMF_bind_congr_left
  intro f
  simp [view, prior_update pk _ _ u c hx, prior_update pk f _ v c hy, Ne.symm hxy]

noncomputable def branch [SampleableType P.Salt] [SampleableType (Table P ι)]
    (adv : Adversary P ι) (pk : ι → P.PubKey) (c : Challenge P ι)
    (state : adv.State) (b : Bool) : ProbComp Bool := by
  classical
  exact if Fresh pk c then do
    let s₁ ← $ᵗ P.Salt
    let s₂ ← $ᵗ P.Salt
    let f ← $ᵗ (Table P ι)
    adv.guess state pk (view pk f c s₁ s₂ b)
  else pure false

noncomputable def resampled [SampleableType P.Salt] [SampleableType P.Nullifier]
    [SampleableType (Table P ι)] (adv : Adversary P ι) (pk : ι → P.PubKey)
    (c : Challenge P ι) (state : adv.State) (b : Bool) : ProbComp Bool := do
  let u ← $ᵗ P.Nullifier
  let v ← $ᵗ P.Nullifier
  let f ← $ᵗ (Table P ι)
  let s₁ ← $ᵗ P.Salt
  let s₂ ← $ᵗ P.Salt
  let w := c.world b
  adv.guess state pk (c.prior.map (event pk f) ++
    [PoolGame.Event.transfer u v (cm pk (w.out1.note s₁)) (cm pk (w.out2.note s₂))])

theorem branch_resampled [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType P.Salt] [SampleableType (Table P ι)]
    (adv : Adversary P ι) (pk : ι → P.PubKey) (c : Challenge P ι)
    (state : adv.State) (b : Bool) (h : Fresh pk c) :
    𝒮[branch adv pk c state b] = 𝒮[resampled adv pk c state b] := by
  classical
  simp only [branch, if_pos h, resampled]
  calc
    _ = 𝒮[do
      let s₁ ← $ᵗ P.Salt
      let s₂ ← $ᵗ P.Salt
      let u ← $ᵗ P.Nullifier
      let v ← $ᵗ P.Nullifier
      let f ← $ᵗ (Table P ι)
      let w := c.world b
      adv.guess state pk (c.prior.map (event pk f) ++
        [PoolGame.Event.transfer u v (cm pk (w.out1.note s₁)) (cm pk (w.out2.note s₂))])] := by
      apply evalSPMF_bind_congr_left
      intro s₁
      apply evalSPMF_bind_congr_left
      intro s₂
      exact fresh_guess_uniform adv pk c state s₁ s₂ b h
    _ = _ := by
      have hh := evalSPMF_bind_comm
        (do let s₁ ← $ᵗ P.Salt; let s₂ ← $ᵗ P.Salt; pure (s₁, s₂))
        (do let u ← $ᵗ P.Nullifier; let v ← $ᵗ P.Nullifier; let f ← $ᵗ (Table P ι); pure (u, v, f))
        (fun ss uvf => adv.guess state pk (c.prior.map (event pk uvf.2.2) ++
          [PoolGame.Event.transfer uvf.1 uvf.2.1
            (cm pk ((c.world b).out1.note ss.1)) (cm pk ((c.world b).out2.note ss.2))]))
      simpa only [bind_assoc, pure_bind] using hh

theorem branch_distance [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType P.Salt] [SampleableType (Table P ι)]
    (adv : Adversary P ι) (pk : ι → P.PubKey) (c : Challenge P ι)
    (state : adv.State) (ε : ℝ) (hε : 0 ≤ ε) (hHide : OwnerGame.Hiding (P := P) ε) :
    (branch adv pk c state true).boolDistAdvantage (branch adv pk c state false) ≤ 2 * ε := by
  classical
  by_cases hf : Fresh pk c
  · have hr := OracleComp.probOutput_congr (x := true) rfl (branch_resampled adv pk c state true hf)
    have hl := OracleComp.probOutput_congr (x := true) rfl (branch_resampled adv pk c state false hf)
    unfold ProbComp.boolDistAdvantage
    rw [hr, hl]
    change (resampled adv pk c state true).boolDistAdvantage (resampled adv pk c state false) ≤ _
    unfold resampled
    apply PoolGame.Averaging.boolDistAdvantage_bind_le_const
    intro u _
    apply PoolGame.Averaging.boolDistAdvantage_bind_le_const
    intro v _
    apply PoolGame.Averaging.boolDistAdvantage_bind_le_const
    intro f _
    let t : P.Commitment → P.Commitment → ProbComp Bool := fun cm₁ cm₂ =>
      adv.guess state pk (c.prior.map (event pk f) ++ [PoolGame.Event.transfer u v cm₁ cm₂])
    exact hiding_pair ε hHide c.right.out1.token c.right.out2.token
      c.left.out1.token c.left.out2.token c.right.out1.amount c.right.out2.amount
      c.left.out1.amount c.left.out2.amount (pk c.right.out1.owner) (pk c.right.out2.owner)
      (pk c.left.out1.owner) (pk c.left.out2.owner) t
  · simp [branch, hf, ProbComp.boolDistAdvantage, hε]

theorem ideal_fixed_eq_coin [SampleableType P.Salt] [SampleableType (Table P ι)]
    (adv : Adversary P ι) (pk : ι → P.PubKey) (c : Challenge P ι) (state : adv.State) :
    𝒮[do
      let f ← $ᵗ (Table P ι)
      let s₁ ← $ᵗ P.Salt
      let s₂ ← $ᵗ P.Salt
      let b ← $ᵗ Bool
      response adv pk f c state s₁ s₂ b] = 𝒮[PrivacyTools.coin (branch adv pk c state)] := by
  classical
  by_cases hf : Fresh pk c
  · simp only [response, if_pos hf, PrivacyTools.coin, branch]
    have he := evalSPMF_bind_comm ($ᵗ (Table P ι))
      (do let s₁ ← $ᵗ P.Salt; let s₂ ← $ᵗ P.Salt; let b ← $ᵗ Bool; pure (s₁, s₂, b))
      (fun f ssb => do
        let g ← adv.guess state pk (view pk f c ssb.1 ssb.2.1 ssb.2.2)
        pure (ssb.2.2 == g))
    simp only [bind_assoc, pure_bind] at he
    rw [he]
    have he' := evalSPMF_bind_comm
      (do let s₁ ← $ᵗ P.Salt; let s₂ ← $ᵗ P.Salt; pure (s₁, s₂)) ($ᵗ Bool)
      (fun ss b => do
        let f ← $ᵗ (Table P ι)
        let g ← adv.guess state pk (view pk f c ss.1 ss.2 b)
        pure (b == g))
    simpa only [bind_assoc, pure_bind, if_pos hf] using he'
  · apply evalSPMF_ext
    intro x
    cases x <;> simp [response, branch, hf, PrivacyTools.coin]

theorem ideal_test_bias_le [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType P.Salt] [SampleableType (Table P ι)]
    (adv : Adversary P ι) (pk : ι → P.PubKey)
    (ε : ℝ) (hε : 0 ≤ ε) (hHide : OwnerGame.Hiding (P := P) ε) :
    |(Pr[= true | do let f ← $ᵗ (Table P ι); test adv pk f]).toReal - 1/2| ≤ ε := by
  have he : 𝒮[do let f ← $ᵗ (Table P ι); test adv pk f] =
      𝒮[do let (c, state) ← adv.choose pk; PrivacyTools.coin (branch adv pk c state)] := by
    simp only [test]
    rw [evalSPMF_bind_comm]
    apply evalSPMF_bind_congr_left
    intro a
    exact ideal_fixed_eq_coin adv pk a.1 a.2
  rw [OracleComp.probOutput_congr (x := true) rfl he]
  have hd := PoolGame.Averaging.boolDistAdvantage_bind_le_const (adv.choose pk)
    (fun a => PrivacyTools.coin (branch adv pk a.1 a.2)) (fun _ => $ᵗ Bool) ε (by
      intro a _
      rw [distance_fair, coin_bias]
      have h := branch_distance adv pk a.1 a.2 ε hε hHide
      linarith)
  simpa [ProbComp.boolDistAdvantage] using hd

/-- Multi-account table transport plus two freshly salted commitment hybrids. -/
theorem advantage_le [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType P.Salt] [SampleableType (ι → P.SpendKey)] [SampleableType (Table P ι)]
    (sup : P.Token → Prop) (adv : Adversary P ι) (η ε : ℝ)
    (hPRF : MultiKeyPublicKeyPRF (P := P) (ι := ι) η)
    (hε : 0 ≤ ε) (hHide : OwnerGame.Hiding (P := P) ε) :
    advantage sup adv ≤ η + rejectionProbability sup adv / 2 := by
  let ideal : ProbComp Bool := do
    let keys ← $ᵗ (ι → P.SpendKey)
    let f ← $ᵗ (Table P ι)
    test adv (P.derivePub ∘ keys) f
  have hp := hPRF (test adv)
  have he : unguarded adv = (do
      let keys ← $ᵗ (ι → P.SpendKey)
      test adv (P.derivePub ∘ keys) (realTable keys)) := by
    simp only [unguarded, draws, test, bind_assoc, pure_bind]
  rw [← he] at hp
  have hi : |(Pr[= true | ideal]).toReal - 1/2| ≤ ε := by
    have hd := PoolGame.Averaging.boolDistAdvantage_bind_le_const ($ᵗ (ι → P.SpendKey))
      (fun keys => do let f ← $ᵗ (Table P ι); test adv (P.derivePub ∘ keys) f)
      (fun _ => $ᵗ Bool) ε (by
        intro keys _
        rw [distance_fair]
        exact ideal_test_bias_le adv (P.derivePub ∘ keys) ε hε hHide)
    simpa [ideal, ProbComp.boolDistAdvantage] using hd
  have ht := abs_sub_le (Pr[= true | unguarded adv]).toReal (Pr[= true | ideal]).toReal (1/2)
  have hd := rejection_transport sup adv
  have ht' := abs_sub_le (Pr[= true | experiment sup adv]).toReal (Pr[= true | unguarded adv]).toReal (1/2)
  change |(Pr[= true | unguarded adv]).toReal - (Pr[= true | ideal]).toReal| ≤ η at hp
  unfold advantage ProbComp.boolDistAdvantage at *
  linarith
