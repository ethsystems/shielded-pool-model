-- Control same_withdraw_rejection_quartered (generated by scripts/gen-controls.py): WithdrawGame.Transport cut after `advantage_le`,
-- unchanged. It must compile.
import WithdrawGame.Basic
import VCVio.OracleComp.QueryTracking.RandomOracle.DeferredSampling

set_option autoImplicit false
set_option relaxedAutoImplicit false

open OracleComp OracleSpec ENNReal OracleComp.DeferredSampling

namespace LeanShieldedPool.WithdrawGame.Transport
open GameCorrespondence
variable {P : PrimSpec} {ι : Type}

abbrev Table (P : PrimSpec) (ι : Type) := (ι × P.Commitment) → P.Nullifier

def cm (pk : ι → P.PubKey) (n : NotePlan P ι) : P.Commitment :=
  P.commit n.token n.amount (pk n.owner) n.salt

def coordinate (pk : ι → P.PubKey) (n : NotePlan P ι) : ι × P.Commitment :=
  (n.owner, cm pk n)

def queries (pk : ι → P.PubKey) : Intent P ι → List (ι × P.Commitment)
  | .deposit _ _ => []
  | .transfer i n₁ n₂ _ _ _ => [(i, cm pk n₁), (i, cm pk n₂)]
  | .withdraw n _ _ => [coordinate pk n]

def event (pk : ι → P.PubKey) (f : Table P ι) :
    Intent P ι → PoolGame.Event (gamePrim P)
  | .deposit n _ => .deposit (cm pk n)
  | .transfer i n₁ n₂ o₁ o₂ _ =>
      .transfer (f (i, cm pk n₁)) (f (i, cm pk n₂)) (cm pk o₁) (cm pk o₂)
  | .withdraw n _ _ => .withdraw (f (coordinate pk n))

def view (pk : ι → P.PubKey) (f : Table P ι) (c : Challenge P ι) (b : Bool) :
    List (PoolGame.Event (gamePrim P)) :=
  c.prior.map (event pk f) ++ [.withdraw (f (coordinate pk (if b then c.right else c.left)))]

def Fresh (pk : ι → P.PubKey) (c : Challenge P ι) : Prop :=
  coordinate pk c.left ∉ c.prior.flatMap (queries pk) ∧
  coordinate pk c.right ∉ c.prior.flatMap (queries pk)

def realTable (keys : ι → P.SpendKey) : Table P ι := fun x => P.nullify x.2 (keys x.1)

theorem view_real (keys : ι → P.SpendKey) (c : Challenge P ι) (b : Bool) :
    view (P.derivePub ∘ keys) (realTable keys) c b = observerView (c.history keys b) := by
  have he (i : Intent P ι) : event (P.derivePub ∘ keys) (realTable keys) i =
      gameEvent (i.resolve keys).event := by
    cases i <;> rfl
  simp only [view, Challenge.history, observerView, events, List.map_append,
    List.map_cons, List.map_nil, List.map_map]
  congr 1
  · exact List.map_congr_left fun i _ => he i

theorem run_nullifiers {sup : P.Token → Prop} {txs : List (Tx P)} {st : St P}
    (h : Run sup txs st) : ∀ nf, nf ∈ txs.flatMap Tx.spends ↔ nf ∈ st.nullifiers := by
  induction h with
  | empty => simp [St.empty]
  | @step txs st st' tx hr hs ih =>
    intro nf
    cases hs <;> simp [List.flatMap_append, Tx.spends, DepositData.post,
      TransferData.post, WithdrawData.post, ih, or_comm, or_left_comm]

theorem queries_real (keys : ι → P.SpendKey) (i : Intent P ι) :
    (queries (P.derivePub ∘ keys) i).map (realTable keys) = (i.resolve keys).spends := by
  cases i <;> rfl

theorem legal_fresh (sup : P.Token → Prop) (keys : ι → P.SpendKey)
    (c : Challenge P ι) (h : Legal sup keys c) : Fresh (P.derivePub ∘ keys) c := by
  rcases h with ⟨_, _, _, st, hr, _, _, hl, hh⟩
  have run : Run sup (c.prior.map (Intent.resolve keys)) st := by
    simpa using RecipientGame.runChecked_sound _ Run.empty hr
  have step (n : NotePlan P ι)
      (hn : realTable keys (coordinate (P.derivePub ∘ keys) n) ∉ st.nullifiers) :
      coordinate (P.derivePub ∘ keys) n ∉ c.prior.flatMap (queries (P.derivePub ∘ keys)) := by
    intro hm
    apply hn
    apply (run_nullifiers run _).mp
    obtain ⟨i, hi, hm⟩ := List.mem_flatMap.mp hm
    apply List.mem_flatMap.mpr
    refine ⟨i.resolve keys, List.mem_map.mpr ⟨i, hi, rfl⟩, ?_⟩
    rw [← queries_real]
    exact List.mem_map.mpr ⟨_, hm, rfl⟩
  exact ⟨step c.left hl.2.2.2.1, step c.right hh.2.2.2.1⟩

noncomputable def response (adv : Adversary P ι) (pk : ι → P.PubKey)
    (f : Table P ι) (c : Challenge P ι) (s : adv.State) (b : Bool) : ProbComp Bool := by
  classical
  exact if Fresh pk c then do
    let g ← adv.guess s pk (view pk f c b)
    pure (b == g)
  else $ᵗ Bool

noncomputable def test (adv : Adversary P ι) (pk : ι → P.PubKey)
    (f : Table P ι) : ProbComp Bool := do
  let (c, s) ← adv.choose pk
  let b ← $ᵗ Bool
  response adv pk f c s b

/-- Information-theoretic joint-table premise. The test receives every public key and
all account tables. The ideal table is independent of all public keys. -/
def MultiKeyPublicKeyPRF [SampleableType (ι → P.SpendKey)] [SampleableType (Table P ι)]
    (ε : ℝ) : Prop :=
  ∀ t : (ι → P.PubKey) → Table P ι → ProbComp Bool,
    |(Pr[= true | do
        let keys ← $ᵗ (ι → P.SpendKey)
        t (P.derivePub ∘ keys) (realTable keys)]).toReal -
      (Pr[= true | do
        let keys ← $ᵗ (ι → P.SpendKey)
        let f ← $ᵗ (Table P ι)
        t (P.derivePub ∘ keys) f]).toReal| ≤ ε

theorem event_update [DecidableEq (ι × P.Commitment)] (pk : ι → P.PubKey)
    (f : Table P ι) (x : ι × P.Commitment) (u : P.Nullifier) (i : Intent P ι)
    (hx : x ∉ queries pk i) : event pk (Function.update f x u) i = event pk f i := by
  cases i <;> simp_all [event, queries, coordinate, ne_comm]

theorem prior_update [DecidableEq (ι × P.Commitment)] (pk : ι → P.PubKey)
    (f : Table P ι) (x : ι × P.Commitment) (u : P.Nullifier) (c : Challenge P ι)
    (hx : x ∉ c.prior.flatMap (queries pk)) :
    c.prior.map (event pk (Function.update f x u)) = c.prior.map (event pk f) := by
  apply List.map_congr_left
  intro i hi
  apply event_update
  intro h
  exact hx (List.mem_flatMap.mpr ⟨i, hi, h⟩)

theorem uniform_update_cont {D R α : Type} [Finite D] [DecidableEq D]
    [Finite R] [Nonempty R] [SampleableType R] [SampleableType (D → R)]
    (x : D) (k : (D → R) → ProbComp α) :
    𝒮[do let f ← $ᵗ (D → R); k f] =
      𝒮[do let u ← $ᵗ R; let f ← $ᵗ (D → R); k (Function.update f x u)] := by
  have h := evalSPMF_uniformSample_bind_update (R := R) x
  have hh := congrArg (fun p => p >>= fun f => 𝒮[k f]) h
  simpa only [← evalSPMF_bind, bind_assoc, pure_bind] using hh.symm

theorem fresh_guess_uniform [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType (Table P ι)] (adv : Adversary P ι) (pk : ι → P.PubKey)
    (c : Challenge P ι) (s : adv.State) (b : Bool) (h : Fresh pk c) :
    𝒮[do let f ← $ᵗ (Table P ι); adv.guess s pk (view pk f c b)] =
    𝒮[do let u ← $ᵗ P.Nullifier; let f ← $ᵗ (Table P ι);
         adv.guess s pk (c.prior.map (event pk f) ++ [PoolGame.Event.withdraw u])] := by
  classical
  rw [uniform_update_cont (coordinate pk (if b then c.right else c.left))]
  apply evalSPMF_bind_congr_left
  intro u
  apply evalSPMF_bind_congr_left
  intro f
  have hx : coordinate pk (if b then c.right else c.left) ∉
      c.prior.flatMap (queries pk) := by cases b <;> simp_all [Fresh]
  simp [view, prior_update pk f _ u c hx]


theorem fair_coin_guess (g : ProbComp Bool) :
    𝒮[do let b ← $ᵗ Bool; let z ← g; pure (b == z)] = 𝒮[$ᵗ Bool] := by
  rw [evalSPMF_bind_comm]
  apply evalSPMF_ext
  intro x
  rw [probOutput_bind_of_const g (r := Pr[= x | $ᵗ Bool])]
  · simp
  · intro z _
    cases z <;> cases x <;> simp

theorem ideal_response_fair [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType (Table P ι)] (adv : Adversary P ι) (pk : ι → P.PubKey)
    (c : Challenge P ι) (s : adv.State) :
    𝒮[do let f ← $ᵗ (Table P ι); let b ← $ᵗ Bool; response adv pk f c s b] =
      𝒮[$ᵗ Bool] := by
  classical
  rw [evalSPMF_bind_comm]
  by_cases h : Fresh pk c
  · let g : ProbComp Bool := do
      let u ← $ᵗ P.Nullifier
      let f ← $ᵗ (Table P ι)
      adv.guess s pk (c.prior.map (event pk f) ++ [PoolGame.Event.withdraw u])
    calc
      _ = 𝒮[do let b ← $ᵗ Bool; let z ← g; pure (b == z)] := by
        apply evalSPMF_bind_congr_left
        intro b
        simp only [response, if_pos h]
        have hh := congrArg (fun p => p >>= fun z => 𝒮[(pure (b == z) : ProbComp Bool)])
          (fresh_guess_uniform adv pk c s b h)
        simpa only [g, ← evalSPMF_bind, bind_assoc] using hh
      _ = _ := fair_coin_guess g
  · apply evalSPMF_ext
    intro x
    simp [response, h]

theorem ideal_test_fair [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType (Table P ι)] (adv : Adversary P ι) (pk : ι → P.PubKey) :
    𝒮[do let f ← $ᵗ (Table P ι); test adv pk f] = 𝒮[$ᵗ Bool] := by
  simp only [test]
  rw [evalSPMF_bind_comm]
  apply evalSPMF_ext
  intro x
  rw [probOutput_bind_of_const (adv.choose pk) (r := Pr[= x | $ᵗ Bool])]
  · simp
  · intro a _
    exact OracleComp.probOutput_congr rfl (ideal_response_fair adv pk a.1 a.2)

theorem rejected_eq_not_legal (sup : P.Token → Prop) (keys : ι → P.SpendKey)
    (c : Challenge P ι) (b : Bool) : rejected sup keys c b = @decide (¬ Legal sup keys c) (Classical.propDecidable _) := by
  classical
  by_cases h : Legal sup keys c
  · obtain ⟨st, run⟩ := legal_realizable sup keys c h b
    simp [rejected, h, RecipientGame.runChecked_complete run]
  · simp [rejected, h]

theorem challenge_eq_reject_response (sup : P.Token → Prop) (adv : Adversary P ι)
    (keys : ι → P.SpendKey) (c : Challenge P ι) (s : adv.State) (b : Bool) :
    challengeExp sup adv keys c s b =
      if rejected sup keys c b then $ᵗ Bool
      else response adv (P.derivePub ∘ keys) (realTable keys) c s b := by
  classical
  rw [rejected_eq_not_legal]
  by_cases h : Legal sup keys c
  · simp [challengeExp, h, legal_guarded_log sup keys c h b, response,
      legal_fresh sup keys c h, view_real]
  · simp [challengeExp, h]

noncomputable def draws [SampleableType (ι → P.SpendKey)] (adv : Adversary P ι) :
    ProbComp ((ι → P.SpendKey) × Challenge P ι × adv.State × Bool) := do
  let b ← $ᵗ Bool
  let keys ← $ᵗ (ι → P.SpendKey)
  let (c, s) ← adv.choose (P.derivePub ∘ keys)
  pure (keys, c, s, b)

noncomputable def unguarded [SampleableType (ι → P.SpendKey)] (adv : Adversary P ι) :
    ProbComp Bool := do
  let a ← draws adv
  response adv (P.derivePub ∘ a.1) (realTable a.1) a.2.1 a.2.2.1 a.2.2.2

theorem rejection_transport [SampleableType (ι → P.SpendKey)]
    (sup : P.Token → Prop) (adv : Adversary P ι) :
    (experiment sup adv).boolDistAdvantage (unguarded adv) ≤ rejectionProbability sup adv / 2 := by
  have hd := RecipientGame.rejection_distance_le (draws adv)
    (fun a => rejected sup a.1 a.2.1 a.2.2.2)
    (fun a => response adv (P.derivePub ∘ a.1) (realTable a.1) a.2.1 a.2.2.1 a.2.2.2)
  simpa only [draws, unguarded, experiment, rejectionProbability, bind_assoc, pure_bind,
    challenge_eq_reject_response] using hd

theorem unguarded_eq_test [SampleableType (ι → P.SpendKey)] (adv : Adversary P ι) :
    𝒮[unguarded adv] = 𝒮[do
      let keys ← $ᵗ (ι → P.SpendKey)
      test adv (P.derivePub ∘ keys) (realTable keys)] := by
  simp only [unguarded, draws, bind_assoc, pure_bind]
  rw [evalSPMF_bind_comm]
  apply evalSPMF_bind_congr_left
  intro keys
  exact evalSPMF_bind_comm _ _ _

/-- All mixed prefixes are permitted. The residual is the original WithdrawGame illegality
probability, including failed nullifier freshness guards. No salt-spread premise is used. -/
theorem advantage_le [Finite ι] [Finite P.Commitment]
    [Finite P.Nullifier] [Nonempty P.Nullifier] [SampleableType P.Nullifier]
    [SampleableType (ι → P.SpendKey)] [SampleableType (Table P ι)]
    (sup : P.Token → Prop) (adv : Adversary P ι) (ε : ℝ)
    (hPRF : MultiKeyPublicKeyPRF (P := P) (ι := ι) ε) :
    advantage sup adv ≤ ε + rejectionProbability sup adv / 2 := by
  have hp := hPRF (test adv)
  have hi : Pr[= true | do
      let keys ← $ᵗ (ι → P.SpendKey)
      let f ← $ᵗ (Table P ι)
      test adv (P.derivePub ∘ keys) f] = 1 / 2 := by
    rw [probOutput_bind_of_const ($ᵗ (ι → P.SpendKey)) (r := 1 / 2)]
    · simp
    · intro keys _
      simpa using OracleComp.probOutput_congr (x := true) rfl
        (ideal_test_fair adv (P.derivePub ∘ keys))
  rw [hi, ← OracleComp.probOutput_congr (x := true) rfl (unguarded_eq_test adv)] at hp
  norm_num at hp
  have ht := abs_sub_le (Pr[= true | experiment sup adv]).toReal
    (Pr[= true | unguarded adv]).toReal (1 / 2)
  have hd := rejection_transport sup adv
  unfold advantage ProbComp.boolDistAdvantage at *
  linarith
