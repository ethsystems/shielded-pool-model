/-!
# Semantics of printed ACIR (Noir 1.0.0-beta.21), opcode subset of the shielded-pool circuits

The data modules are generated by `scripts/acir2lean.py` from the output of
`noir-inspector print-acir` (beta.21, 89a0f0fa). The included deposit, transfer and withdraw
prints contain three opcode kinds (counts in `expected.json`, under `extraction`):

* `ASSERT lhs = rhs` (ACIR `AssertZero`). The printer picks a linear term with coefficient
  1 or -1 and shows the expression as `wK = rest`, or shows `0 = expr` when there is none.
  Either way the expression is zero in the field exactly when `lhs - rhs` is divisible by
  `P` (the printed expression is the original one or its negation). Coefficients are the
  printed signed decimals.
* `BLACKBOX::RANGE input: wK, bits: n`: the canonical value of `wK` is below `2^n`.
* `BRILLIG CALL`: unconstrained witness generation. It adds no constraint.

Witness values are canonical field elements (`Fin P`).
-/

namespace AcirLean

/-- The BN254 scalar field modulus (ACIR's `FieldElement`). -/
def P : Nat := 21888242871839275222246405745257275088548364400416034343698204186575808495617

/-- A witness assignment: every witness index gets a canonical field element. -/
abbrev Assignment := Nat → Fin P

/-- A printed polynomial: product terms `c*wi*wj`, linear terms `c*wi`, and a constant. -/
structure Expr where
  mul : List (Int × Nat × Nat)
  lin : List (Int × Nat)
  const : Int
  deriving Repr, DecidableEq

def Expr.eval (e : Expr) (w : Assignment) : Int :=
  e.mul.foldl (fun acc t => acc + t.1 * ((w t.2.1).val : Int) * ((w t.2.2).val : Int)) 0
  + e.lin.foldl (fun acc t => acc + t.1 * ((w t.2).val : Int)) 0
  + e.const

inductive Opcode where
  /-- `ASSERT wK = rhs` (`lhs = some K`) or `ASSERT 0 = rhs` (`lhs = none`). -/
  | assertZero (lhs : Option Nat) (rhs : Expr)
  /-- `BLACKBOX::RANGE input: wK, bits: n`. -/
  | range (input : Nat) (bits : Nat)
  /-- `BRILLIG CALL func: f, ..., outputs: [...]`: no constraint. -/
  | brilligCall (func : Nat) (outputs : List Nat)
  deriving Repr, DecidableEq

def lhsVal : Option Nat → Assignment → Int
  | some k, w => ((w k).val : Int)
  | none, _ => 0

def Opcode.Holds : Opcode → Assignment → Prop
  | .assertZero lhs rhs, w => (lhsVal lhs w - rhs.eval w) % (P : Int) = 0
  | .range i bits, w => (w i).val < 2 ^ bits
  | .brilligCall _ _, _ => True

/-- A Boolean check with the same meaning as `Holds` (used for concrete witnesses). -/
def Opcode.check : Opcode → Assignment → Bool
  | .assertZero lhs rhs, w => decide ((lhsVal lhs w - rhs.eval w) % (P : Int) = 0)
  | .range i bits, w => decide ((w i).val < 2 ^ bits)
  | .brilligCall _ _, _ => true

theorem Opcode.check_iff (op : Opcode) (w : Assignment) : op.check w = true ↔ op.Holds w := by
  cases op <;> simp [Opcode.check, Opcode.Holds]

/-- One ACIR function (`func 0`): parameter lists and the opcode list in printed order. -/
structure Circuit where
  privateParams : List Nat
  publicParams : List Nat
  returnValues : List Nat
  opcodes : List Opcode

/-- An assignment satisfies the circuit when every opcode holds. -/
def Circuit.Satisfied (c : Circuit) (w : Assignment) : Prop :=
  ∀ op ∈ c.opcodes, op.Holds w

theorem Circuit.holds_of_mem {c : Circuit} {w : Assignment} (h : c.Satisfied w)
    {op : Opcode} (hm : op ∈ c.opcodes) : op.Holds w :=
  h op hm

theorem Circuit.range_of_mem {c : Circuit} {w : Assignment} (h : c.Satisfied w)
    {i bits : Nat} (hm : Opcode.range i bits ∈ c.opcodes) : (w i).val < 2 ^ bits :=
  h _ hm

theorem Circuit.satisfied_of_all {c : Circuit} {w : Assignment}
    (h : c.opcodes.all (fun op => op.check w) = true) : c.Satisfied w := by
  intro op hm
  rw [List.all_eq_true] at h
  exact (Opcode.check_iff op w).mp (h op hm)

end AcirLean
